    |School Staff|
      :Get Staff Approval;
      if (Approve Request?) then (approved)
        :Request Approved;
        |School Staff|
        :Send Payment to Service to Renter;
        |Website|
        :Get Payment;
              if (Payment Service) then (payment succeeds)
                 :Saves Booking;
                 |Renter|
                 :Confirmation Email of Booking;
                stop

              else (payment failed)
                 |Website|
                 :Record Failed Payment;
                 :Notify Renter via Email;
                 |Renter|
                 :Email Notification of Failed Payment;

              endif
        stop

      else (rejected)
        |School Staff|
        :Request Rejected;
        |Website|
        :Record Rejection;
        :Notify Renter via Email;
        |Renter|
        :Email Notification of Rejection;
      endif
    stop
  else (no)
    |Website|
    :Show not available;
    :return to beginning or quit;
    stop
  |Website|
